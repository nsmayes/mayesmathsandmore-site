# mayesmathsandmore.com on Hostinger: one address only, always https, with no www
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mayesmathsandmore.com%{REQUEST_URI} [L,R=301]

# keep the page fresh; pictures and fonts can be kept for a week
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
